import numpy as np
import pandas as pd
import matplotlib.pyplot as plt


df=pd.read_csv("data/test_100.csv")
df.info()
del df['Unnamed: 0']

num_cols=len(df.columns)  #1
def plot_all_columns(df, chart_type="line", figsize=(20, 25)):
     plt.figure(figsize=figsize)   
    # 20개 컬럼을 4열 기준으로 배치하기 위한 행(row) 수 계산
     chart_col = 4
     chart_row = (num_cols // chart_col) + 1
     count=1 
     for i, col in enumerate(df.columns):
         
         plt.subplot(chart_row, chart_col, count)
         count +=1
         
         if chart_type  == 'line':
             plt.plot(df.index, df[col])
         elif chart_type  == 'scatter':
             plt.scatter(df.index, df[col])
         else:
             plt.line(df.index, df[col])
         
     plt.tight_layout()
     plt.show()   
plot_all_columns(df, 'line')         
         
  
